# Salin file ini jadi ".env" lalu isi API key kamu

# API key dari console.anthropic.com (dipakai buat cari momen menarik dari transkrip)
ANTHROPIC_API_KEY=your_key_here

# Model Whisper yang dipakai: tiny, base, small, medium, large
# "base" cukup akurat dan tidak terlalu berat untuk mulai
WHISPER_MODEL=base
